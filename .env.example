# Copy this file to .env and fill in your keys:
#   PowerShell:  Copy-Item .env.example .env
# NEVER commit your actual .env file to Git!

# Your OpenRouter key (https://openrouter.ai/settings/keys). Paste the WHOLE key
# after the = sign. It already starts with sk-or-v1-, so don't type that part twice.
OPENROUTER_API_KEY=

# Vision model used to identify machines in photos (optional; this is the default)
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
